{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreatureCard",
  "type": "object",
  "definitions": {
    "actionItem": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "effect": { "type": "string" },
        "attack": {
          "type": "object",
          "required": ["type", "bonus", "hit"],
          "properties": {
            "type": { "type": "string" },
            "bonus": { "type": "integer" },
            "reach": { "type": "string" },
            "range": { "type": "string" },
            "hit": { "type": "string" },
            "extra": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "size",
    "type",
    "alignment",
    "armor_class",
    "hit_points",
    "speed",
    "initiative",
    "ability_scores",
    "saving_throws",
    "senses",
    "languages",
    "challenge_rating",
    "actions"
  ],
  "properties": {
    "name": { "type": "string" },
    "size": { "type": "string" },
    "type": { "type": "string" },
    "subtype": { "type": "string" },
    "alignment": { "type": "string" },
    "armor_class": { "type": "integer", "minimum": 1 },
    "hit_points": { "type": "string" },
    "speed": {
      "type": "object",
      "required": ["walk"],
      "properties": {
        "walk": { "type": "number" },
        "burrow": { "type": "number" },
        "climb": { "type": "number" },
        "fly": { "type": "number" },
        "swim": { "type": "number" },
        "hover": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "initiative": { "type": "string" },
    "ability_scores": {
      "type": "object",
      "required": ["str", "dex", "con", "int", "wis", "cha"],
      "properties": {
        "str": { "type": "integer", "minimum": 1 },
        "dex": { "type": "integer", "minimum": 1 },
        "con": { "type": "integer", "minimum": 1 },
        "int": { "type": "integer", "minimum": 1 },
        "wis": { "type": "integer", "minimum": 1 },
        "cha": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "saving_throws": {
      "type": "object",
      "required": ["str", "dex", "con", "int", "wis", "cha"],
      "properties": {
        "str": { "type": "integer" },
        "dex": { "type": "integer" },
        "con": { "type": "integer" },
        "int": { "type": "integer" },
        "wis": { "type": "integer" },
        "cha": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "object",
      "properties": {
        "acrobatics": { "type": "integer" },
        "animal_handling": { "type": "integer" },
        "arcana": { "type": "integer" },
        "athletics": { "type": "integer" },
        "deception": { "type": "integer" },
        "history": { "type": "integer" },
        "insight": { "type": "integer" },
        "intimidation": { "type": "integer" },
        "investigation": { "type": "integer" },
        "medicine": { "type": "integer" },
        "nature": { "type": "integer" },
        "perception": { "type": "integer" },
        "performance": { "type": "integer" },
        "persuasion": { "type": "integer" },
        "religion": { "type": "integer" },
        "sleight_of_hand": { "type": "integer" },
        "stealth": { "type": "integer" },
        "survival": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "gear": {
      "type": "array",
      "items": { "type": "string" }
    },
    "senses": {
      "type": "object",
      "required": ["passive_perception"],
      "properties": {
        "passive_perception": { "type": "integer" },
        "darkvision": { "type": "number" },
        "blindsight": { "type": "number" },
        "tremorsense": { "type": "number" },
        "truesight": { "type": "number" }
      },
      "additionalProperties": false
    },
    "languages": { "type": "string" },
    "challenge_rating": {
      "type": "object",
      "required": ["cr", "xp", "proficiency_bonus"],
      "properties": {
        "cr": { "type": "string" },
        "xp": { "type": "integer", "minimum": 0 },
        "proficiency_bonus": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "traits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "effect"],
        "properties": {
          "name": { "type": "string" },
          "effect": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "damage_immunities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "damage_resistances": {
      "type": "array",
      "items": { "type": "string" }
    },
    "damage_vulnerabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "condition_immunities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/actionItem"
      }
    },
    "legendary_actions": {
      "type": "object",
      "required": ["uses", "actions"],
      "properties": {
        "uses": {
          "type": "integer",
          "minimum": 1,
          "description": "Base legendary action uses per round"
        },
        "lair_uses": {
          "type": "integer",
          "minimum": 1,
          "description": "Total legendary action uses per round when inside the lair"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/actionItem"
          }
        }
      },
      "additionalProperties": false
    },
    "bonus_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "effect"],
        "properties": {
          "name": { "type": "string" },
          "effect": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "reactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "effect"],
        "properties": {
          "name": { "type": "string" },
          "effect": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}